# Copy to `.env` to override the defaults baked into docker-compose.yaml.
# The stack starts without this file; it exists so you never have to edit the
# compose file to change a credential.

# Unique id of the KRaft cluster. Generate your own with:
#   docker run --rm confluentinc/cp-kafka:8.3.2 kafka-storage random-uuid
# It is written into the metadata log on first boot, so changing it afterwards
# requires `docker compose down -v`.
CLUSTER_ID=4qX_flwRRQGrMeqHg468mQ

# Local-only PostgreSQL credentials. Not secrets: the database holds nothing
# but the public CTA station list and is never exposed outside the compose
# network plus localhost.
# Host port for the Kafka UI. The container always listens on 8080.
KAFKA_UI_PORT=8085

POSTGRES_USER=cta_admin
POSTGRES_PASSWORD=chicago
POSTGRES_DB=cta
